{
  "rules": {
    "salas": {
      "$sala": {
        ".write": "auth != null && data.child('dono').val() === auth.uid",
        "dono": {
          ".read": false,
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.val() === auth.uid"
        },
        "chave": {
          ".read": "auth != null && root.child('salas').child($sala).child('dono').val() === auth.uid",
          ".write": "auth != null && root.child('salas').child($sala).child('dono').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length >= 12 && newData.val().length <= 64"
        },
        "quadro": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salas').child($sala).child('dono').val() === auth.uid",
          ".validate": "newData.hasChildren(['j', 't']) && newData.child('j').isString() && newData.child('j').val().length < 4000000"
        },
        "vista": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('salas').child($sala).child('dono').val() === auth.uid",
          ".validate": "newData.hasChildren(['x', 'y', 'w', 'h'])"
        },
        "tablet": {
          "$chave": {
            ".read": "auth != null && $chave === root.child('salas').child($sala).child('chave').val()",
            ".write": "auth != null && $chave === root.child('salas').child($sala).child('chave').val()",
            "apagar": {
              "$id": {
                ".validate": "newData.hasChildren(['p', 'r']) && newData.child('p').isString() && newData.child('p').val().length < 6000"
              }
            },
            "tracos": {
              "$id": {
                ".validate": "newData.hasChildren(['p', 'w']) && newData.child('p').isString() && newData.child('p').val().length < 60000"
              }
            }
          }
        }
      }
    }
  }
}
